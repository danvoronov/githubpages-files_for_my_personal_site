<!DOCTYPE html>
<html>
<head profile="http://gmpg.org/xfn/11">
  {% set pageTitle = post.title if post else title %}
  {% set pageDescription = post.excerpt if post else (description or site.updatesDescription) %}
  {% set pageRelativeUrl = post.url if post else page.url %}
  {% set canonicalUrl = pageRelativeUrl | absoluteUrl(site.url) %}
  {% set pageImage = (post.imageUrl if (post and post.imageUrl) else (site.image or "/dan-files/i/dan_doska_4site.jpg")) | absoluteUrl(site.url) %}
  {% set siteTitle = ((pageTitle | htmlEscape | safe) ~ " | " ~ site.name) if pageTitle else site.name %}
  <meta http-equiv="content-type" content="application/xhtml+xml; charset=UTF-8" />
  <title>{{ siteTitle }}</title>
  <meta name="description" content="{{ pageDescription | htmlEscape | safe }}">

  <!-- Open Graph / Facebook / Slack / Discord -->
  <meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.name | htmlEscape | safe }}">
  <meta property="og:title" content="{{ siteTitle }}">
  <meta property="og:description" content="{{ pageDescription | htmlEscape | safe }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  {% if pageImage %}
  <meta property="og:image" content="{{ pageImage }}">
  {% endif %}
  {% if post and post.date %}
  <meta property="article:published_time" content="{{ post.date }}">
  {% endif %}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="{% if post and post.imageUrl %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ siteTitle }}">
  <meta name="twitter:description" content="{{ pageDescription | htmlEscape | safe }}">
  {% if pageImage %}
  <meta name="twitter:image" content="{{ pageImage }}">
  {% endif %}

  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="icon" href="/favicon.ico">
  <link rel="alternate" type="application/rss+xml" title="RSS 2.0" href="/updates/feed.xml" />
  <link rel="stylesheet" type="text/css" href="/ru/dan-wpdata/themes/dan-kiev-ua/style.css" media="screen" />
  <link rel="stylesheet" type="text/css" href="/ru/dan-wpdata/themes/dan-kiev-ua/header.css" media="screen" />
  <link href="/ru/dan-wpdata/themes/dan-kiev-ua/styles/default.css" rel="stylesheet" type="text/css" />
  <link href="/ru/dan-wpdata/themes/dan-kiev-ua/custom.css" rel="stylesheet" type="text/css" />
  <style type="text/css">
    html,
    body {
      min-height: 100%;
      background: #54D98F;
    }

    body.custom {
      margin: 0;
      background: #54D98F;
      color: #3f4652;
    }

    #page-background {
      position: fixed;
      inset: 0;
      background: #54D98F;
      z-index: 0;
      pointer-events: none;
    }

    #page-content {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      background: #54D98F;
    }

    #wrap {
      box-sizing: border-box;
      padding: 12px 0 36px;
    }

    #content.updates-shell {
      box-sizing: border-box;
      width: min(1162px, calc(100vw - 32px));
      min-height: 0;
      margin: 0 auto;
      background: #fff;
      border: 10px solid #e5950c;
    }

    #content.updates-shell #main-full {
      width: auto;
      padding: 0;
    }

    #content.updates-shell .post {
      padding: 0;
    }

    #content.updates-shell .entry {
      box-sizing: border-box;
      width: 100%;
      padding: 32px 32px 36px;
      line-height: 1.55;
    }

    #content.updates-shell .entry p {
      margin: 0 0 18px;
      padding: 0;
      line-height: 1.55;
    }

    #content.updates-shell .entry strong {
      color: #4b8f62;
      font-weight: 700;
    }

    #content.updates-shell .entry hr {
      height: 1px;
      margin: 20px 0 36px;
      border: 0;
      background: #5d6570;
    }

    .updates-post-nav {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      width: 100%;
      margin-bottom: 36px;
    }

    .updates-post-nav__links {
      min-width: 0;
    }

    .updates-post-nav time {
      color: #4f5967;
      white-space: nowrap;
    }

    .prose {
      box-sizing: border-box;
      width: 100%;
      max-width: 930px;
      margin-left: auto;
      margin-right: auto;
      font-size: clamp(18px, 0.35vw + 14px, 20px);
      line-height: 1.55;
    }

    .prose > * {
      box-sizing: border-box;
      max-width: 100%;
    }

    .updates-index-content {
      box-sizing: border-box;
      width: 100%;
      max-width: 100%;
      margin: 0;
      font-size: 1.125rem;
    }

    .prose h2 {
      margin-top: 36px;
    }

    #content.updates-shell .entry p:has(+ ul, + ol),
    .prose p:has(+ ul, + ol) {
      margin-bottom: 4px !important;
    }

    #content.updates-shell .entry ul,
    #content.updates-shell .entry ol,
    .prose ul,
    .prose ol {
      margin-top: 0 !important;
      margin-bottom: 18px !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      line-height: 1.55;
    }

    #content.updates-shell .entry ul,
    .prose ul {
      list-style-type: disc;
      padding-left: 28px;
    }

    #content.updates-shell .entry ol,
    .prose ol {
      list-style-type: decimal;
      padding-left: 28px;
    }

    #content.updates-shell .entry ul li,
    #content.updates-shell .entry ol li,
    .prose ul li,
    .prose ol li {
      padding: 2px 0;
      margin: 0;
      line-height: 1.55;
    }

    #content.updates-shell .entry li p,
    .prose li p {
      margin: 0 0 6px !important;
      line-height: 1.55;
    }

    #content.updates-shell .entry li p:last-child,
    .prose li p:last-child {
      margin-bottom: 0 !important;
    }

    #content.updates-shell .entry ul ul,
    #content.updates-shell .entry ol ul,
    .prose ul ul,
    .prose ol ul {
      list-style-type: circle;
      margin-top: 2px !important;
      margin-bottom: 2px !important;
      padding-left: 22px;
    }

    #content.updates-shell .entry ul ol,
    #content.updates-shell .entry ol ol,
    .prose ul ol,
    .prose ol ol {
      list-style-type: decimal;
      margin-top: 2px !important;
      margin-bottom: 2px !important;
      padding-left: 22px;
    }

    a[href*="/feed.xml"],
    .rss-link {
      color: #DD4723;
      text-decoration: underline dotted #DD4723 !important;
      text-underline-offset: 3px;
    }

    a[href*="/feed.xml"]:hover,
    .rss-link:hover {
      text-decoration: underline solid #DD4723 !important;
    }

    #content.updates-shell .entry p.updates-tags,
    .updates-tags {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      max-width: 930px;
      margin: 64px auto 36px !important;
      padding: 0;
    }

    .updates-tag {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 4px;
      background: #ededed;
      color: #4f5967;
      line-height: 1.2;
    }

    .updates-tags-sep {
      display: inline-flex;
      align-items: center;
      color: #888;
      font-weight: normal;
      user-select: none;
      padding: 0 4px;
    }

    #content.updates-shell .entry .share-buttons,
    .share-buttons {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin: 0;
      padding: 0;
    }

    #content.updates-shell .entry .share-buttons a,
    .share-buttons a {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 4px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      line-height: 1.2;
      color: #ffffff !important;
      transition: opacity 0.15s ease, background-color 0.15s ease;
    }

    #content.updates-shell .entry .share-buttons a:hover,
    .share-buttons a:hover {
      opacity: 0.9;
      text-decoration: none !important;
    }

    #content.updates-shell .entry .share-buttons a.share-btn--x,
    .share-buttons a.share-btn--x {
      background: #000000;
    }
    #content.updates-shell .entry .share-buttons a.share-btn--x:hover,
    .share-buttons a.share-btn--x:hover {
      background: #222222;
    }

    #content.updates-shell .entry .share-buttons a.share-btn--telegram,
    .share-buttons a.share-btn--telegram {
      background: #2481cc;
    }
    #content.updates-shell .entry .share-buttons a.share-btn--telegram:hover,
    .share-buttons a.share-btn--telegram:hover {
      background: #1c6ba8;
    }

    #content.updates-shell .entry .share-buttons a.share-btn--facebook,
    .share-buttons a.share-btn--facebook {
      background: #1877f2;
    }
    #content.updates-shell .entry .share-buttons a.share-btn--facebook:hover,
    .share-buttons a.share-btn--facebook:hover {
      background: #1462c7;
    }

    #content.updates-shell .entry p.updates-prev-post,
    .updates-prev-post {
      box-sizing: border-box;
      max-width: 930px;
      margin: 44px auto 24px !important;
      padding: 16px 20px !important;
      border: 1px solid #e5950c;
      border-radius: 8px;
      background: #fffdf8;
      color: #4f5967;
      font-size: 1.15rem;
      line-height: 1.5;
      text-align: center;
    }

    .updates-prev-post a {
      font-weight: 600;
    }

    #content.updates-shell .entry p.updates-rss-footer,
    .updates-rss-footer {
      max-width: 930px;
      margin: 24px auto 0 !important;
      padding: 0;
      color: #6d6257;
      font-size: 0.95rem;
    }

    @media (max-width: 720px) {
      #wrap {
        padding: 8px 0 24px;
      }

      #content.updates-shell {
        width: min(100vw - 16px, 1162px);
        border-width: 8px;
      }

      #content.updates-shell .entry {
        padding: 20px 16px 22px;
      }

      .updates-post-nav {
        display: block;
      }

      .updates-post-nav time {
        display: block;
        margin-top: 8px;
      }
    }
  </style>
</head>
<body class="custom">
  <div id="page-background"></div>
  <div id="page-content">
    <div id="wrap">
      <div id="content" class="white updates-shell">
        <div id="main-full">
          <div class="post">
            <div class="entry">
              {{ content | safe }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      function openExternalLinksInNewTab() {
        const links = document.querySelectorAll("a");
        for (let i = 0; i < links.length; i++) {
          const href = links[i].getAttribute("href");
          if (href && /^https?:\/\//i.test(href)) {
            try {
              const url = new URL(href, window.location.href);
              if (url.hostname !== window.location.hostname) {
                links[i].setAttribute("target", "_blank");
                if (!links[i].hasAttribute("rel")) {
                  links[i].setAttribute("rel", "noopener");
                }
              }
            } catch (_e) {}
          }
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", openExternalLinksInNewTab);
      } else {
        openExternalLinksInNewTab();
      }

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") {
          return;
        }

        const backLink = document.querySelector("[data-esc-back]");

        if (!backLink || !backLink.href) {
          return;
        }

        event.preventDefault();
        window.location.href = backLink.href;
      });
    })();
  </script>
</body>
</html>
